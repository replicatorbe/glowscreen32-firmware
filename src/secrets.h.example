// Gabarit de configuration — copier en `src/secrets.h` puis renseigner les valeurs.
// `src/secrets.h` est exclu du dépôt (voir .gitignore) : il contient des identifiants.
#pragma once

// --- Wi-Fi ---
#define WIFI_SSID "MonReseau"
#define WIFI_PASS "mot-de-passe-wifi"

// --- Serveur Jeedom ---
// Hôte (IP ou nom) sans schéma ni chemin : le client ajoute
// http://<host>/plugins/glowscreen32/core/php/api.php
// (et non core/api/ : voir la correction v1.1 du contrat d'API)
#define JEEDOM_HOST "192.168.1.10"

// Clé API du plugin glowscreen32, visible dans Jeedom > Plugins > GlowScreen32.
// Elle est transmise en en-tête HTTP X-GLOWSCREEN32-APIKEY (contrat v1.1).
// Tant qu'elle vaut sa valeur de gabarit, le firmware n'émet AUCUNE requête et
// affiche « Sans clé » dans le bandeau.
#define JEEDOM_APIKEY "clef-api-du-plugin-glowscreen32"

// Aucune identité d'écran ici : la carte se reconnaît à sa propre MAC.
// Le même fichier, donc le même binaire, convient à toutes les cartes du parc.
